# Artifact runtime. Supply canonical fhs/ and the statically linked Linux Host.
FROM busybox:1.37 AS home
RUN mkdir -p /home/ww/.ww && chown -R 1000:1000 /home/ww

FROM gcr.io/distroless/static-debian12

COPY ww /usr/local/bin/ww
COPY fhs/ /usr/share/wetware/kernel/

COPY --from=home --chown=1000:1000 /home/ww/ /home/ww/
ENV HOME=/home/ww
WORKDIR /home/ww
# A whole-home volume cannot hide the immutable FHS under /usr/share.
VOLUME ["/home/ww"]

USER 1000:1000
EXPOSE 2025 2026 2080

ENTRYPOINT ["/usr/local/bin/ww"]
# Kernel base mount. Production k8s manifests can add layers
# (e.g. example cells from IPNS) and flags (--identity, --port, etc).
CMD ["run", "/usr/share/wetware/kernel"]
