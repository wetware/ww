# Artifact runtime. Supply canonical fhs/ and ww-amd64 / ww-arm64.
# The cc runtime supports both GNU release targets and the x86_64 musl binary.
FROM busybox:1.37 AS home
RUN mkdir -p /home/ww/.ww && chown -R 1000:1000 /home/ww

FROM gcr.io/distroless/cc-debian13

ARG TARGETARCH

COPY ww-${TARGETARCH} /usr/local/bin/ww
COPY fhs/ /usr/share/wetware/kernel/

COPY --from=home --chown=1000:1000 /home/ww/ /home/ww/
ENV HOME=/home/ww
ENV WW_FHS_ROOT=/usr/share/wetware/kernel
WORKDIR /home/ww
# A whole-home volume cannot hide the immutable FHS under /usr/share.
VOLUME ["/home/ww"]

USER 1000:1000
EXPOSE 2025 2026 2080

ENTRYPOINT ["/usr/local/bin/ww"]
CMD ["run"]
